/**
 * @fileoverview Firestore Security Rules for Seven Properties Bespoke.
 *
 * Core Philosophy:
 * This ruleset provides public read access to all data (properties and content) while restricting write access to authenticated users.
 *
 * Data Structure:
 * - /propertyCollections/{collectionId}
 * - /propertyCollections/{collectionId}/properties/{propertyId}
 * - /content/{contentId}: Stores content targeted towards HNWI.
 *
 * Key Security Decisions:
 * - Public read access for all properties and content.
 * - Write access is restricted to authenticated users. In a production app, this would be further restricted to admin roles.
 *
 * Denormalization for Authorization:
 *  - Not applicable, as there is no ownership based authorization.
 * Structural Segregation:
 * - Data is segregated into separate collections based on entity type.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants public read access to property collections and their properties.
     * Write access is restricted to authenticated users.
     */
    match /propertyCollections/{collectionId} {
      allow get, list: if true;
      allow write: if request.auth != null;

      match /properties/{propertyId} {
        allow get, list: if true;
        allow write: if request.auth != null;
      }
    }

    /**
     * @description Grants public read access to content data and allows owner-only writes.
     * @path /content/{contentId}
     * @allow (get, list) - Any user can read content data.
     * @deny (create, update, delete) - No user can modify content data.
     * @principle Allows public access for reads.
     */
    match /content/{contentId} {
      allow get, list: if true;
      allow create, update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }
  }
}
