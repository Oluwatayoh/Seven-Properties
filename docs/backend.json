
{
  "entities": {
    "PropertyCollection": {
      "title": "Property Collection",
      "type": "object",
      "description": "A collection or grouping of related real estate properties.",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the collection." },
        "title": { "type": "string", "description": "Name of the collection." },
        "location": { "type": "string", "description": "General location of the properties in this collection." },
        "description": { "type": "string", "description": "A description of the property collection." },
        "tags": {
          "type": "array",
          "description": "Descriptive tags for the collection.",
          "items": { "type": "string" }
        },
        "imageUrl": {
          "type": "string",
          "format": "uri",
          "description": "URL of the collection's main image."
        },
        "imageHint": {
          "type": "string",
          "description": "AI hint for generating the collection image."
        }
      },
      "required": ["id", "title", "location", "description"]
    },
    "Property": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Property",
      "type": "object",
      "description": "Represents a real estate property offered by Seven Properties.",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the property." },
        "title": { "type": "string", "description": "Name of the property." },
        "description": { "type": "string", "description": "Detailed description of the property." },
        "price": { "type": "string", "description": "Price of the property as a formatted string (e.g., '₦1.2B')." },
        "bedrooms": { "type": "number", "description": "Number of bedrooms." },
        "bathrooms": { "type": "number", "description": "Number of bathrooms." },
        "sqft": { "type": "number", "description": "Total square footage." },
        "propertyType": {
          "type": "string",
          "description": "The type of property.",
          "enum": ["Land", "Apartment", "Commercial", "Simplex", "Penthouse", "Duplex"]
        },
        "totalUnits": { "type": "number" },
        "floors": { "type": "number" },
        "availableFloors": { "type": "string" },
        "positioningLine": { "type": "string" },
        "imageUrls": {
          "type": "array",
          "description": "URLs of the property's images.",
          "items": { "type": "string", "format": "uri" }
        },
        "imageHints": {
            "type": "array",
            "description": "AI hints for generating images.",
            "items": { "type": "string" }
        }
      },
      "required": ["id", "title", "description", "price", "imageUrls", "propertyType"]
    },
    "Content": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Content",
      "type": "object",
      "description": "Represents content targeted towards HNWI.",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the content." },
        "title": { "type": "string", "description": "Title of the content." },
        "body": { "type": "string", "description": "Main body of the content." },
        "keywords": {
          "type": "array",
          "description": "Keywords associated with the content for SEO purposes.",
          "items": { "type": "string" }
        },
        "contentType": { "type": "string", "description": "Type of content (e.g., article, blog post, video)." }
      },
      "required": ["id", "title", "body", "keywords", "contentType"]
    }
  },
  "auth": { "providers": ["password", "anonymous"] },
  "firestore": {
    "structure": [
      {
        "path": "/propertyCollections/{collectionId}",
        "definition": {
          "entityName": "PropertyCollection",
          "schema": { "$ref": "#/entities/PropertyCollection" },
          "description": "Stores groupings of real estate properties.",
          "subcollections": [
            {
              "path": "properties",
              "definition": {
                "entityName": "Property",
                "schema": { "$ref": "#/entities/Property" },
                "description": "Stores individual properties within a collection."
              }
            }
          ]
        }
      },
      {
        "path": "/content/{contentId}",
        "definition": {
          "entityName": "Content",
          "schema": { "$ref": "#/entities/Content" },
          "description": "Stores content targeted towards HNWI. Accessible to all users."
        }
      }
    ]
  }
}
